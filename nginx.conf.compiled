env LAPIS_ENVIRONMENT=restart;
worker_processes 1;
error_log logs/error.log notice;

events {
    worker_connections 1024;
}

http {
    include mime.types;

    server {
        listen 80;
        server_name wikibcrp.com www.wikibcrp.com;
        lua_code_cache on;

        location / {
            default_type text/html;
            content_by_lua_block {
                require("lapis").serve("app")
            }
        }
    }
}